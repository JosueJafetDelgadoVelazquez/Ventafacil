<Window x:Class="Ventafacil.Desktop.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar contraseña"
        SizeToContent="WidthAndHeight"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F5F8">
    <Border Padding="26" Background="White" CornerRadius="10">
        <StackPanel>
            <TextBlock Text="Configurar contraseña"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#17324D" />
            <TextBlock Text="Se solicitará cada vez que abras VentaFácil."
                       Margin="0,6,0,18"
                       Foreground="#65758B"
                       TextWrapping="Wrap" />
            <TextBlock Text="Contraseña (mínimo 6 caracteres)" Margin="0,0,0,5" />
            <PasswordBox x:Name="PasswordBox"
                         Height="38"
                         Padding="8"
                         FontSize="15" />
            <TextBlock Text="Confirma la contraseña" Margin="0,14,0,5" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="38"
                         Padding="8"
                         FontSize="15" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,10,0,0"
                       Foreground="#B42318"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Cancelar"
                        MinWidth="90"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="Guardar"
                        MinWidth="90"
                        Padding="12,7"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
