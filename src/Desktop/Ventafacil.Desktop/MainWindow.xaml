<Window x:Class="Ventafacil.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VentaFácil - Punto de venta"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#F3F5F8">
    <Grid>
        <Grid x:Name="LoginView" Visibility="Collapsed">
            <Border Width="390"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="VentaFácil"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#17324D"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Ingresa tu contraseña para continuar"
                               Margin="0,8,0,24"
                               Foreground="#65758B"
                               HorizontalAlignment="Center" />
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Height="42"
                                 FontSize="16"
                                 Padding="8"
                                 KeyDown="LoginPasswordBox_KeyDown" />
                    <Button Content="Iniciar sesión"
                            Height="42"
                            Margin="0,16,0,0"
                            Background="#1769AA"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="Login_Click" />
                    <TextBlock x:Name="LoginStatusText"
                               Margin="0,12,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PointOfSaleView" Visibility="Collapsed" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Punto de venta"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#17324D" />
                    <TextBlock Text="Busca productos y agrégalos al carrito"
                               Margin="0,4,0,0"
                               Foreground="#65758B" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="ConfigurePasswordButton"
                        Content="Configurar contraseña"
                        Padding="16,10"
                        VerticalAlignment="Center"
                        Click="ConfigurePassword_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="20" Background="White" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Productos"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#17324D" />
                        <Grid Grid.Row="1" Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProductSearchBox"
                                     Height="38"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Nombre, código de barras o categoría"
                                     KeyDown="ProductSearchBox_KeyDown" />
                            <Button Grid.Column="1"
                                    Content="Buscar"
                                    Margin="8,0,0,0"
                                    Padding="14,6"
                                    Click="SearchProducts_Click" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListView x:Name="ProductsList"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="#E7EBF0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#17324D" />
                                                    <TextBlock Text="{Binding Barcode}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               Foreground="#65758B" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <Button Content="Agregar"
                                                            Padding="12,6"
                                                            Tag="{Binding}"
                                                            Click="AddToCart_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="ProductsEmptyText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#65758B"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="20" Background="White" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Carrito"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D" />
                            <Button Grid.Column="1"
                                    Content="Vaciar"
                                    Padding="10,5"
                                    Click="ClearCart_Click" />
                        </Grid>
                        <ListView x:Name="CartList"
                                  Grid.Row="1"
                                  Margin="0,12,0,12"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17324D" />
                                            <TextBlock Text="{Binding Quantity, StringFormat=Cantidad: {0}}"
                                                       Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="#65758B" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:C2}}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <Button Content="−"
                                                    Width="30"
                                                    Height="30"
                                                    Tag="{Binding}"
                                                    Click="RemoveFromCart_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2">
                            <Separator />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D" />
                                <TextBlock x:Name="CartTotalText"
                                           Grid.Column="1"
                                           Text="$0.00"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#1769AA" />
                            </Grid>
                            <TextBlock x:Name="CartStatusText"
                                       Margin="0,10,0,0"
                                       Foreground="#65758B"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
