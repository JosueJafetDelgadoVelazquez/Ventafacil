<Window x:Class="Ventafacil.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ventafacil.Desktop"
        Title="VentaFácil - Punto de venta"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#F3F5F8">
    <Window.Resources>
        <local:ImagePathToBitmapConverter x:Key="ImagePathConverter" />
    </Window.Resources>
    <Grid>
        <Grid x:Name="LoginView" Visibility="Collapsed">
            <Border Width="390"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="VentaFácil"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#17324D"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Ingresa tu contraseña para continuar"
                               Margin="0,8,0,24"
                               Foreground="#65758B"
                               HorizontalAlignment="Center" />
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Height="42"
                                 FontSize="16"
                                 Padding="8"
                                 KeyDown="LoginPasswordBox_KeyDown" />
                    <Button Content="Iniciar sesión"
                            Height="42"
                            Margin="0,16,0,0"
                            Background="#1769AA"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="Login_Click" />
                    <TextBlock x:Name="LoginStatusText"
                               Margin="0,12,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PointOfSaleView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#17324D" Padding="20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="VentaFácil"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="PUNTO DE VENTA"
                                   Margin="0,4,0,28"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#AFC4D8" />
                        <Button Content="Punto de venta"
                                x:Name="PointOfSaleButton"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Background="#245779"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="PointOfSale_Click" />
                        <Button Content="Inventario"
                                x:Name="InventoryButton"
                                Margin="0,8,0,0"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Inventory_Click" />
                        <Button Content="Configuración"
                                x:Name="SettingsButton"
                                Margin="0,8,0,0"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Settings_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="SalesContentView" Grid.Column="1" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Punto de venta"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#17324D" />
                        <TextBlock Text="Busca productos y agrégalos al carrito"
                                   Margin="0,4,0,0"
                                   Foreground="#65758B" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="20" Background="White" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Productos"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D" />
                            <Grid Grid.Row="1" Margin="0,14,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProductSearchBox"
                                         Height="38"
                                         Padding="10,6"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Nombre, código de barras o categoría"
                                         KeyDown="ProductSearchBox_KeyDown" />
                                <Button Grid.Column="1"
                                        Content="Buscar"
                                        Margin="8,0,0,0"
                                        Padding="14,6"
                                        Click="SearchProducts_Click" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <ListView x:Name="ProductsList"
                                          BorderThickness="0"
                                          SelectionChanged="ProductsList_SelectionChanged"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" BorderBrush="#E7EBF0" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="64" CornerRadius="6" Background="#EEF2F6">
                                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                                   Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#17324D" />
                                                        <TextBlock Text="{Binding Barcode}"
                                                                   Margin="0,3,0,0"
                                                                   FontSize="12"
                                                                   Foreground="#65758B" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold" />
                                                        <Button Content="Agregar"
                                                                Padding="12,6"
                                                                Tag="{Binding}"
                                                                Click="AddToCart_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="ProductsEmptyText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#65758B"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="20" Background="White" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Carrito"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D" />
                                <Button Grid.Column="1"
                                        Content="Vaciar"
                                        Padding="10,5"
                                        Click="ClearCart_Click" />
                            </Grid>
                            <Border x:Name="SelectedProductPreview"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Padding="10"
                                    Background="#F8FAFC"
                                    BorderBrush="#E7EBF0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="76" CornerRadius="6" Background="#EEF2F6">
                                        <Image x:Name="SelectedProductImage"
                                               Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedProductName"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17324D"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="SelectedProductPrice"
                                                   Margin="0,4,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1769AA" />
                                        <TextBlock x:Name="SelectedProductStock"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="#65758B" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ListView x:Name="CartList"
                                      Grid.Row="2"
                                      Margin="0,12,0,12"
                                      BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="50" Height="50" CornerRadius="5" Background="#EEF2F6">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#17324D" />
                                                <TextBlock Text="{Binding Quantity, StringFormat=Cantidad: {0}}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12"
                                                           Foreground="#65758B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LineTotal, StringFormat={}{0:C2}}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="−"
                                                        Width="30"
                                                        Height="30"
                                                        Tag="{Binding}"
                                                        Click="RemoveFromCart_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="3">
                                <Separator />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#17324D" />
                                    <TextBlock x:Name="CartTotalText"
                                               Grid.Column="1"
                                               Text="$0.00"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#1769AA" />
                                </Grid>
                                <TextBlock x:Name="CartStatusText"
                                           Margin="0,10,0,0"
                                           Foreground="#65758B"
                                           TextWrapping="Wrap" />
                                <Button x:Name="SellButton"
                                        Content="Vender"
                                        Margin="0,14,0,0"
                                        Padding="14,10"
                                        IsEnabled="False"
                                        Click="Sell_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="InventoryContentView"
                  Grid.Column="1"
                  Margin="28,24"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Inventario"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#17324D" />
                        <TextBlock Text="Administra los productos disponibles para venta"
                                   Margin="0,4,0,0"
                                   Foreground="#65758B" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Crear producto"
                            Padding="16,10"
                            VerticalAlignment="Center"
                            Background="#1769AA"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="CreateProduct_Click" />
                </Grid>

                <Border Grid.Row="1" Padding="20" Background="White" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Productos registrados"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#17324D" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ListView x:Name="InventoryProductsList"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10"
                                                BorderBrush="#E7EBF0"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="64" Height="64" CornerRadius="6" Background="#EEF2F6">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#17324D" />
                                                    <TextBlock Text="{Binding Barcode, TargetNullValue=Sin código de barras}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               Foreground="#65758B" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Category, TargetNullValue=Sin categoría}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#65758B" />
                                                <StackPanel Grid.Column="4"
                                                            Margin="16,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#17324D" />
                                                    <TextBlock Text="{Binding Stock, StringFormat=Existencia: {0}}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               Foreground="#65758B" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="InventoryEmptyText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#65758B"
                                       Text="No hay productos registrados todavía."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SettingsContentView"
                  Grid.Column="1"
                  Margin="28,24"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Configuración"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#17324D" />
                    <TextBlock Text="Administra el acceso y genera reportes del inventario"
                               Margin="0,4,0,0"
                               Foreground="#65758B" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="24"
                                Background="White"
                                CornerRadius="10">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                                <TextBlock Text="Contraseña de acceso"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D" />
                                <TextBlock x:Name="PasswordSettingsDescription"
                                           Margin="0,6,0,20"
                                           Foreground="#65758B"
                                           TextWrapping="Wrap" />

                                <StackPanel x:Name="CurrentPasswordPanel" Visibility="Collapsed">
                                    <TextBlock Text="Contraseña actual" Margin="0,0,0,5" />
                                    <PasswordBox x:Name="CurrentPasswordBox"
                                                 Height="38"
                                                 Padding="8"
                                                 FontSize="15" />
                                </StackPanel>

                                <TextBlock Text="Nueva contraseña (mínimo 6 caracteres)"
                                           Margin="0,16,0,5" />
                                <PasswordBox x:Name="NewPasswordBox"
                                             Height="38"
                                             Padding="8"
                                             FontSize="15" />
                                <TextBlock Text="Confirma la nueva contraseña" Margin="0,14,0,5" />
                                <PasswordBox x:Name="ConfirmNewPasswordBox"
                                             Height="38"
                                             Padding="8"
                                             FontSize="15" />
                                <TextBlock x:Name="PasswordSettingsStatus"
                                           Margin="0,12,0,0"
                                           Foreground="#B42318"
                                           TextWrapping="Wrap" />
                                <Button Content="Guardar contraseña"
                                        HorizontalAlignment="Right"
                                        Margin="0,18,0,0"
                                        Padding="16,9"
                                        Background="#1769AA"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Click="SavePasswordSettings_Click" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="24"
                                Background="White"
                                CornerRadius="10">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                                <TextBlock Text="Reportes"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D" />
                                <TextBlock Text="Genera un archivo CSV con el inventario actual, incluyendo precios, categorías y existencias."
                                           Margin="0,6,0,16"
                                           Foreground="#65758B"
                                           TextWrapping="Wrap" />
                                <Button Content="Crear reporte de inventario"
                                        HorizontalAlignment="Left"
                                        Padding="16,9"
                                        Background="#1769AA"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Click="CreateInventoryReport_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
