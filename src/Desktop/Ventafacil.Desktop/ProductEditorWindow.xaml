<Window x:Class="Ventafacil.Desktop.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear producto"
        Width="480"
        Height="760"
        MinHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="EditorTitleText"
                       Text="Crear producto"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#17324D" />
            <TextBlock x:Name="EditorDescriptionText"
                       Text="Completa los datos para agregarlo al inventario"
                       Margin="0,4,0,0"
                       Foreground="#65758B" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Imagen del producto" FontWeight="SemiBold" Foreground="#17324D" />
                <Border Height="150"
                        Margin="0,6,0,8"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Background="#F8FAFC"
                        CornerRadius="8">
                    <Grid>
                        <Image x:Name="ProductImagePreview"
                               Margin="8"
                               Stretch="Uniform"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="NoImageText"
                                   Text="Sin imagen"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#94A3B8" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Seleccionar imagen"
                            Padding="12,8"
                            Background="#1769AA"
                            Foreground="White"
                            Click="SelectImage_Click" />
                    <Button x:Name="RemoveImageButton"
                            Content="Quitar"
                            Margin="8,0,0,0"
                            Padding="12,8"
                            Visibility="Collapsed"
                            Click="RemoveImage_Click" />
                </StackPanel>

                <TextBlock Text="Nombre *" FontWeight="SemiBold" Foreground="#17324D" />
                <TextBox x:Name="NameTextBox" Height="38" Margin="0,6,0,14" Padding="8" />

                <TextBlock Text="Código de barras" FontWeight="SemiBold" Foreground="#17324D" />
                <TextBox x:Name="BarcodeTextBox" Height="38" Margin="0,6,0,14" Padding="8" />

                <TextBlock Text="Categoría" FontWeight="SemiBold" Foreground="#17324D" />
                <ComboBox x:Name="CategoryComboBox"
                          IsEditable="True"
                          Height="38"
                          Margin="0,6,0,14"
                          Padding="8"
                          SelectedIndex="-1">
                    <ComboBoxItem Content="Ropa" />
                    <ComboBoxItem Content="Perecederos" />
                    <ComboBoxItem Content="Normales" />
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Precio de venta *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="PriceTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Costo *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="CostTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Existencia *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="StockTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mínimo de inventario *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="MinStockTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Margin="0,2,0,8"
                           Foreground="#B42318"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinWidth="96"
                    Padding="14,9"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="SaveProductButton"
                    Content="Guardar producto"
                    MinWidth="140"
                    Padding="14,9"
                    Background="#1769AA"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
