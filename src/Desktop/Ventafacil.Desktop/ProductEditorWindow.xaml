<Window x:Class="Ventafacil.Desktop.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear producto"
        Width="480"
        Height="670"
        MinHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Crear producto"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#17324D" />
            <TextBlock Text="Completa los datos para agregarlo al inventario"
                       Margin="0,4,0,0"
                       Foreground="#65758B" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre *" FontWeight="SemiBold" Foreground="#17324D" />
                <TextBox x:Name="NameTextBox" Height="38" Margin="0,6,0,14" Padding="8" />

                <TextBlock Text="Código de barras" FontWeight="SemiBold" Foreground="#17324D" />
                <TextBox x:Name="BarcodeTextBox" Height="38" Margin="0,6,0,14" Padding="8" />

                <TextBlock Text="Categoría" FontWeight="SemiBold" Foreground="#17324D" />
                <TextBox x:Name="CategoryTextBox" Height="38" Margin="0,6,0,14" Padding="8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Precio de venta *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="PriceTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Costo *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="CostTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Existencia inicial *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="StockTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mínimo de inventario *" FontWeight="SemiBold" Foreground="#17324D" />
                        <TextBox x:Name="MinStockTextBox" Height="38" Margin="0,6,0,14" Padding="8" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Margin="0,2,0,8"
                           Foreground="#B42318"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinWidth="96"
                    Padding="14,9"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Guardar producto"
                    MinWidth="140"
                    Padding="14,9"
                    Background="#1769AA"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
