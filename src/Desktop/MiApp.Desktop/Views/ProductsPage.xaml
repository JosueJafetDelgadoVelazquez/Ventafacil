<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MiApp.Desktop.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiApp.Desktop.Views"
    xmlns:domain="using:MiApp.Domain.Entities"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ LISTA DE PRODUCTOS ============ -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Productos" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBox Grid.Row="1"
                     PlaceholderText="Buscar por nombre, código o categoría"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Products}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Product">
                        <Grid Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind local:ProductsPage.Subtitle(Category, Barcode)}"
                                           Opacity="0.7" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind local:ProductsPage.Money(Price)}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind local:ProductsPage.StockText(Stock)}"
                                           HorizontalAlignment="Right" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ============ FORMULARIO ============ -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Nuevo" Command="{x:Bind ViewModel.NewCommand}" />
                </Grid>

                <TextBox Header="Nombre *"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />

                <TextBox Header="Código de barras"
                         Text="{x:Bind ViewModel.Barcode, Mode=TwoWay}" />

                <TextBox Header="Categoría"
                         Text="{x:Bind ViewModel.Category, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox Header="Precio de venta" Width="180" Minimum="0"
                               SpinButtonPlacementMode="Hidden"
                               Value="{x:Bind ViewModel.Price, Mode=TwoWay}" />
                    <NumberBox Header="Costo" Width="180" Minimum="0"
                               SpinButtonPlacementMode="Hidden"
                               Value="{x:Bind ViewModel.Cost, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox Header="Stock actual" Width="180" Minimum="0"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind ViewModel.Stock, Mode=TwoWay}" />
                    <NumberBox Header="Stock mínimo" Width="180" Minimum="0"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind ViewModel.MinStock, Mode=TwoWay}" />
                </StackPanel>

                <ToggleSwitch Header="Disponible para la venta"
                              OnContent="Activo" OffContent="Inactivo"
                              IsOn="{x:Bind ViewModel.IsActive, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}" />
                    <Button Content="Eliminar"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="Delete_Click" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
